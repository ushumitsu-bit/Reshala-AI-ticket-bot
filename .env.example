# ═══════════════════════════════════════════════════════════
#                    ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ═══════════════════════════════════════════════════════════

# Telegram Bot — получить у @BotFather
BOT_TOKEN=

# Remnawave Panel API
REMNAWAVE_API_URL=
REMNAWAVE_API_TOKEN=

# Группа поддержки — ID группы с топиками (начинается с -100)
SUPPORT_GROUP_ID=

# ID менеджеров через запятую (получить у @userinfobot)
ALLOWED_MANAGER_IDS=

# ═══════════════════════════════════════════════════════════
#                    URL ДЛЯ MINI APP
# ═══════════════════════════════════════════════════════════

# Название вашего сервиса
SERVICE_NAME=S-Access Support

# Публичный URL бэкенда для Mini App
# Для локальной разработки: http://localhost:8001
# Для продакшена: https://api.your-domain.com
REACT_APP_BACKEND_URL=https://api.your-domain.com

# Домен Mini App (для кнопок в боте)
MINI_APP_DOMAIN=https://api.your-domain.com

# Прямой URL Mini App (для локальной разработки: http://localhost:3000)
# Если заполнено, имеет приоритет над MINI_APP_DOMAIN
# MINI_APP_URL=http://localhost:3000

# Режим разработки: отключает проверку X-Telegram-Init-Data (нужно для localhost)
# [!IMPORTANT] Включите в false для продакшена!
SKIP_AUTH=false

# Время жизни initData (секунды). Старше — 403 (защита от replay). Дефолт 86400 (24 ч).
TELEGRAM_INITDATA_TTL=86400

# Разрешённые Origin для CORS (через запятую). Обязательно для продакшена.
# Пример: https://your-miniapp-domain.com
CORS_ORIGINS=

# Путь к файлу состояния бота (для персистентности)
PERSISTENCE_PATH=/data/bot_state.pickle

# ═══════════════════════════════════════════════════════════
#                    БАЗА ДАННЫХ (MongoDB)
# ═══════════════════════════════════════════════════════════

# Строка подключения (для Docker с авторизацией)
# Должна совпадать с MONGO_INITDB_ROOT_USERNAME / MONGO_INITDB_ROOT_PASSWORD
MONGO_URL=mongodb://admin:changeme@mongodb:27017

# Имя базы данных
DB_NAME=reshala_support

# MongoDB root-учётка (ОБЯЗАТЕЛЬНО смените пароль!)
# ВНИМАНИЕ: на существующем volume root-юзер не пересоздаётся — см. docs/ENV.md
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=changeme

# TTL кэша настроек (секунды). Уменьшает нагрузку на Mongo. Дефолт 60.
SETTINGS_CACHE_TTL=60

# ═══════════════════════════════════════════════════════════
#                    ОПЦИОНАЛЬНО (Bedolaga)
# ═══════════════════════════════════════════════════════════

# Bedolaga API для проверки баланса (если используется)
# Указывайте Bedolaga WEBHOOK_URL
# BEDOLAGA_API_URL=
# Указывайте Bedolaga WEB_API_DEFAULT_TOKEN
# BEDOLAGA_API_TOKEN=

# ═══════════════════════════════════════════════════════════
#                    САМООБУЧЕНИЕ (KB Distiller)
# ═══════════════════════════════════════════════════════════

# Включить фоновый воркер дистилляции (on/off).
# При multi-worker (uvicorn --workers N) оставьте on только на одном воркере.
KB_DISTILL_ENABLED=on

# Интервал запуска дистилляции (минут)
KB_DISTILL_INTERVAL_MIN=15

# Сколько архивных тикетов обрабатывать за один прогон
KB_DISTILL_BATCH=5

# Уведомлять менеджеров о новых черновиках (on/off)
KB_SUGGESTION_NOTIFY=on
